# ============================================================
# El Viaje Por Chile - Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=production
# URL pública donde se hospeda la app (la usa Mercado Pago para los back_urls)
APP_URL=https://www.elviaje.cl

# --- Gemini AI (guiones y audio TTS) ---
# Obtén tu key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modelos (opcional, ya tienen valores por defecto reales)
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- Mercado Pago Chile (pasarela de cobros) ---
# Token de acceso (producción APP_USR-... o sandbox TEST-...)
# Sin esto la app funciona en MODO DEMO (no cobra dinero real).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# URL del webhook IPN (opcional, se deduce de APP_URL)
# MERCADOPAGO_WEBHOOK_URL=https://www.elviaje.cl/api/mercadopago/webhook

# --- Precios en Pesos Chilenos (CLP) ---
MP_SINGLE_TOUR_PRICE_CLP=14990
MP_ANNUAL_MEMBERSHIP_PRICE_CLP=49990
MP_ENTERPRISE_PRICE_CLP=189990

# --- Propietario / Recaudación ---
OWNER_EMAIL=juancarlos.castaing@gmail.com
OWNER_NAME=El Viaje SPA

# --- Google OAuth (login real de creadores) ---
# Crea las credenciales en https://console.cloud.google.com/apis/credentials
# Origen autorizado: http://localhost:3000  (o tu dominio)
# URI de redirección autorizada: https://www.elviaje.cl/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT=https://www.elviaje.cl/api/auth/google/callback

# Secreto para firmar las cookies de sesión (cámbialo en producción)
SESSION_SECRET=cambia-este-secreto-en-produccion

# Redis para sesiones (obligatorio al escalar a varias instancias)
# Ej: redis://localhost:6379  o  rediss://:password@host:6379
REDIS_URL=

# --- Persistencia duradera en Google Cloud Storage (producción en Cloud Run) ---
# Si defines este bucket, data/tours.json y data/users.json se guardan AHÍ y
# sobreviven reinicios/reescalados de Cloud Run (el disco del contenedor es efímero).
# La cuenta de servicio de Cloud Run necesita rol "Storage Object Admin" sobre el bucket.
# Ej: elviaje-data
# GCS_BUCKET=

# Códigos de consultoría válidos (separados por coma) para canjear membresía gratis
VALID_VOUCHER_CODES=VIAJE-PATRIMONIO,CONSULTORIA-TIENDAELVIAJE
